# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://icloud_sync:password@postgres:5432/icloud_sync

# Nextcloud Configuration (can also be configured via UI)
NEXTCLOUD_URL=https://your-nextcloud.example.com
NEXTCLOUD_USERNAME=your-username
NEXTCLOUD_PASSWORD=your-app-password

# Home Assistant Configuration (optional)
HOME_ASSISTANT_URL=http://your-homeassistant:8123
HOME_ASSISTANT_TOKEN=your-long-lived-access-token

# Security
ENCRYPTION_SECRET=CHANGE_ME_TO_RANDOM_STRING_IN_PRODUCTION

# iCloud Authentication (rustpush)
# Authenticate with Apple ID via the API: POST /api/auth/login
# Anisette server for Apple authentication
ANISETTE_URL=https://ani.sidestore.io/v3
